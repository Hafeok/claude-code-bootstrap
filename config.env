# Shared by every environment. Nothing here is secret.

# Modules setup.sh runs, in order. Names are files in modules/. Each is cached
# with the environment; the whole run must finish in about five minutes.
MODULES="base dotnet rust azure claude-user"

# .NET channels whose latest SDK is installed and cached. A repository whose
# global.json none of these satisfies gets its exact SDK at session start,
# uncached; add its channel here to cache it.
DOTNET_CHANNELS="10.0"

# The identity cloud sessions commit as. The public half of each environment's
# signing key is registered as a signing key on the GitHub account this email
# belongs to.
GIT_AGENT_NAME="Claude (Emil)"
GIT_AGENT_EMAIL="claude+emil@okkels-klein.dk"
