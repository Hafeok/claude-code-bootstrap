# Values every profile starts from. A profile file overrides any of them.

# Modules run in this order. Names are files in modules/.
MODULES="base claude-user"

# The identity cloud sessions commit as. The public half of each environment's
# signing key is registered as a signing key on the GitHub account this email
# belongs to.
GIT_AGENT_NAME="Claude (Emil)"
GIT_AGENT_EMAIL="claude+emil@okkels-klein.dk"
